{
  "name": "math_prog",
  "category": "random_task",
  "description": "Evolved closed-ISA math programs (register machine). Candidates are executed live on randomized func/goal/goal_io tasks; honesty enforced by held-out cases, input-usage tracking, bounded consts, and degenerate-output penalties. The params list is unused by the Python domain (MathProgDomain decodes programs itself); it exists only so the spec loads.",
  "simulator": "math_prog_simulate",
  "gen_model_type": "mlp",
  "transferable": false,
  "params": [
    {"name": "s0", "type": "float", "range": [0.0, 1.0]}
  ],
  "behavioral_dims": [["task_kind", 4, 0, 4], ["difficulty", 5, 1, 5]],
  "scoring": {
    "components": [
      {"metric": "heldout_exact", "weight": 60.0},
      {"metric": "train_exact", "weight": 25.0},
      {"metric": "err_score", "weight": 10.0},
      {"metric": "fit_score", "weight": 15.0},
      {"metric": "uses_inputs", "weight": 8.0},
      {"metric": "parsimony", "weight": 4.0},
      {"metric": "speed_score", "weight": 2.0}
    ],
    "penalties": [
      {"flag": "const_cheat", "metric": "const_cheat", "op": ">", "value": 0.5, "penalty": -50.0},
      {"flag": "degenerate", "metric": "degenerate", "op": ">", "value": 0.5, "penalty": -30.0}
    ],
    "hardening": ["no_nan"]
  }
}
